# Runtime
LOG_LEVEL=INFO

# Bot identity (optional for report/reconciliation context)
BOT_WALLET_ADDRESS=

# Local dashboard server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Manual approval via Telegram (optional but required if manual_confirmation_enabled=true)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API hosts
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_HOST=https://gamma-api.polymarket.com
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CLOB_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Live trading credentials (required only when all live gates are explicitly enabled)
LIVE_TRADING=false
EXECUTION_MODE=paper
DRY_RUN=true
POLYMARKET_PRIVATE_KEY=
POLYMARKET_CHAIN_ID=137
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Daily advisor: disabled until the model, channel and execution gates are audited.
ADVISOR_ENABLED=false
ADVISOR_LIVE_ENABLED=false
ADVISOR_BROKER_CONFIGURED=false
ADVISOR_CONTROL_STATE=paused
ADVISOR_INTEGRITY_KEY=
ADVISOR_CONFIRMATION_KEY=
ADVISOR_RECIPIENT=
ADVISOR_MIN_PROBABILITY=0.60
ADVISOR_MIN_EDGE_BPS=150
ADVISOR_MAX_EDGE_BPS=5000
ADVISOR_MAX_STAKE_USDC=5
ADVISOR_MAX_DAILY_LOSS_USDC=5
ADVISOR_MAX_QUOTE_AGE_SECONDS=60
ADVISOR_MAX_MODEL_AGE_SECONDS=86400
ADVISOR_PROPOSAL_TTL_SECONDS=900
# JSON artifact produced by an independently trained/calibrated sports model.
# Missing or invalid evidence causes abstention; market prices are never used as the model.
ADVISOR_EVIDENCE_PATH=
ADVISOR_BANKROLL_USDC=0
ADVISOR_DB_PATH=data/advisor.db
ADVISOR_WEBHOOK_HOST=127.0.0.1
ADVISOR_WEBHOOK_PORT=8787

# WhatsApp Business Cloud API: disabled by default; requires Meta eligibility,
# opt-in, approved template and server-side webhook signature validation.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_POLICY_CONFIRMED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_ALLOWED_NUMBERS=
